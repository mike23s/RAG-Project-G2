# Copy to .env.local (git-ignored) and fill in real values:
#   cp .env.example .env.local

# ---------- Azure AI Foundry ----------
AZURE_OPENAI_ENDPOINT=https://careermatch-resource.openai.azure.com/openai/v1
# Key 1 or Key 2 from the same page.
AZURE_OPENAI_API_KEY=A27AKduYzX5epMu8MlHmZuIjZ5XDyjGcIsgfyqbIiM3LPLWshbutJQQJ99CJACfhMk5XJ3w3AAAAACOGKTvc
CHAT_DEPLOYMENT=gpt-5.4
EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Must match the embedding model output AND the Cosmos vector policy. Changing it = re-embed everything.
EMBEDDING_DIMENSIONS=1536

# ---------- Azure Content Understanding (CV text extraction / OCR) ----------
CONTENTUNDERSTANDING_ENDPOINT=
CONTENTUNDERSTANDING_KEY=
# GA version. Set 2026-06-01-preview only if you need preview features.
CONTENTUNDERSTANDING_API_VERSION=2025-11-01

# ---------- Azure Cosmos DB for NoSQL ----------
# Portal → Cosmos account → Keys → URI
COSMOS_ENDPOINT=https://careermatch-cosmo-db.documents.azure.com:443/
# Portal → Keys → PRIMARY KEY (use a read-write key)
COSMOS_KEY=oyqsV4DtSYPwv7XVTCfzhX6Cu21P69hbz4Gc9SgDRQm8oejcKKt4LnuJPi5qjRCnacChjWrB8PRUACDbAgqd1A==
COSMOS_DATABASE=jobmatch
COSMOS_ADS_CONTAINER=ads
COSMOS_QUERIES_CONTAINER=query_cache

# ---------- JobTech (Arbetsförmedlingen) ----------
JOBSEARCH_BASE_URL=https://jobsearch.api.jobtechdev.se
TAXONOMY_BASE_URL=https://taxonomy.api.jobtechdev.se/v1/taxonomy
# Not required today.
JOBTECH_API_KEY=

# ---------- Retrieval / matching tuning (safe defaults) ----------
# How long a cached (occupation + location) query counts as fresh.
QUERY_CACHE_TTL_SECONDS=86400
# Page size for JobSearch (API maximum is 100) and number of pages per occupation.
MAX_ADS_PER_QUERY=100
MAX_PAGES_PER_QUERY=2
# Number of nearest ads returned by Cosmos vector search.
VECTOR_TOP_K=30
# Cosine similarity cut-off. text-embedding-3 scores are compressed; calibrate on real CVs.
MIN_SIMILARITY=0.30
# How many top candidates are sent to the LLM for re-ranking + explanation.
RERANK_TOP_N=10
# Final score = WEIGHT_LLM * llm_fit + (1 - WEIGHT_LLM) * similarity
WEIGHT_LLM=0.6
